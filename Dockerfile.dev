# Dockerfile para desenvolvimento Angular
FROM node:20-alpine

# Definir diretório de trabalho
WORKDIR /app

# Copiar package.json e package-lock.json
COPY package*.json ./

# Instalar dependências
RUN npm install

# Copiar código fonte
COPY . .

# Expor porta do Angular dev server
EXPOSE 4200

# Comando para iniciar o servidor de desenvolvimento
# --host 0.0.0.0 permite acesso externo ao container
# --poll habilita polling para detectar mudanças em alguns sistemas de arquivos
CMD ["npm", "run", "start", "--", "--host", "0.0.0.0", "--poll", "2000"]
